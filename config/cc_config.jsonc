// 节点独立配置：全配对，补零FFT后白化，直接互相关；不继承DAS几何参数。
{
    "station_csv": "./config/line_380_stations.csv",
    "node_data_dir": "/mnt/nas-changbai/2026SaErTuoHai_passive",
    "node_output_dir": "./outputs/node_ccf_spectral_v1",
    // auto：估算主机峰值不超过可用内存50%则预加载，否则30分钟分块。
    "read_mode": "auto",
    "resume": true,
    "save_every": 30,
    "minute_stack_s": 60.0,
    "cc_len": 10.0,
    "cc_step_s": 5.0,
    "maxlag": 4.0,
    "freqmin": 2.0,
    "freqmax": 30.0,
    "freq_norm": "rma",
    "time_norm": "rma",
    "cc_method": "xcorr",
    "stacking_method": "pws",
    "max_over_std": 1000000000.0,
    "smooth_N": 5,
    "smoothspect_N": 5,
    "time_downsample": 1,
    "space_downsample": 1,
    "cc_dtype": "float32",
    "cc_backend": "cpp_cuda",
    "cc_device": "cuda",
    "cc_cuda_device": 0,
    // 最大窗口批次；显存不足时原生引擎减小窗口或配对批次。
    "cc_batch_chunks": 32,
    // 0：自动配对分块；正整数可用于显存约束和数值验证。
    "cc_pair_batch": 0,
    "cc_memory_safety_fraction": 0.70,
    // 0：按空闲显存规划；正整数约束临时工作区，常驻统计量另计。
    "cc_memory_budget_bytes": 0
}
