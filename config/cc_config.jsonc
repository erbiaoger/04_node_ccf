// 节点全配对CC/TSI：扁平JSONC，字段风格与CC_ChangBai_select一致。
{
    "schema_version": 3,
    "node_data_dir": "/mnt/nas-downstairs1/mohe_cut/z_cut",
    // 输出根目录；自动生成日期、白天范围、raw/tsi子目录，不覆盖旧任务。
    "node_output_dir": "./outputs/node_ccf_fixed",
    // 可选 fixed（默认：整个任务复用固定表）| daily_gps（每天读取当天有效GPS）。
    // daily_gps缺少当天GPS会停止；输出日期目录自动追加_daily_gps，避免混用。
    "station_coordinate_mode": "fixed",
    // fixed时使用的CSV路径；null或省略时使用config/stations_fixed.csv。
    // daily_gps模式忽略此项。
    "station_csv": "./config/stations_fixed.csv",
    // 起止日期均包含；每天仅计算start_time到end_time，结束时刻不包含。
    // date_range：指定日期；all_date：所有日期的规定时段；all_date_time：全部日期全天。
    "processing_time_mode": "all_date",
    "processing_start_date": "2026-07-08",
    "processing_end_date": "2026-07-11",
    "local_timezone": "Asia/Shanghai",
    "start_time": "08:00",
    "end_time": "18:00",

    "freqmin": 1.0,
    "freqmax": 10.0,
    "freq_norm": "rma",
    "time_norm": "rma",
    "cc_method": "xcorr",
    // 文件内第一层：短窗→分钟；与第二层叠加独立。linear或pws。
    "file_stacking_method": "linear",
    // 分钟→输出片段，以及多个TSI片段→一个输出；linear或pws。
    "stacking_method": "pws",
    "cc_enhance_method": "raw",
    "cc_backend": "cpp_cuda",
    "cc_device": "auto",
    "cc_dtype": "float32",
    "cc_cuda_device": 0,
    "cc_memory_budget_gib": 2.0,
    "smooth_N": 5,
    "smoothspect_N": 5,
    "maxlag": 4.0,
    "max_over_std": 1000000000.0,
    "cc_len": 10.0,
    "cc_step_s": 5.0,
    "space_downsample": 1,
    "time_downsample": 1,
    // 原始SAC标称采样率；抗混叠降2后计算采样率为250Hz。
    "sac_sampling_rate_hz": 500.0,
    "sps": 500.0,
    "samp_freq": 500.0,
    "fk_enabled": false,

    // 节点连续时间以minute_stack_s为基本块，并非按SAC文件计时。
    "minute_stack_s": 60.0,
    // 每60个基本块保存一个H5：当前1小时；改30即每30分钟保存。
    "save_every": 120,
    // 每多少基本块做一次TSI。60=1小时，30=30分钟，0=跟随save_every。
    // save_every必须是此值的整数倍，例如每30分钟TSI、每60分钟保存。
    "tsi_files_per_group": 60,
    "tsi_iterations": 4,
    "tsi_stop_rel_l1": 0.005,
    // 节点二维几何模式；不使用DAS按编号判断左右的single_shot模式。
    "tsi_mode": "geographic_all_pairs",
    "tsi_backend": "torch",
    "tsi_device": "cuda",
    "tsi_pair_batch_size": 32,
    "tsi_show_progress": true,
    // 第三台站路径和/差与目标台站间距的最大误差，米。
    "tsi_geometry_max_path_error_m": 10.0,
    "tsi_min_common_k": 1,
    "tsi_taper_enabled": true,
    "tsi_taper_vmin": 500.0,
    "tsi_taper_vmax": 4000.0,
    "tsi_taper_outside_scale": 0.25,
    "tsi_taper_shoulder_fraction": 0.25,

    "read_mode": "block",
    "read_hours": 24.0,
    "io_workers": 8,
    "prefetch_blocks": 0,
    "async_save": 0,
    "cc_batch_chunks": 12,
    "cc_pair_batch": 0,
    "cc_upload_block": 1,
    "cc_reuse_workspace": 1,
    "cc_memory_safety_fraction": 0.70,
    "resume": true
}
